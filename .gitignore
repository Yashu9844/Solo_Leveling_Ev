# ── Dependencies ────────────────────────────────────────────────────────────
node_modules/
.pnpm-store/
.yarn/
.npm/

# ── Build output ────────────────────────────────────────────────────────────
dist/
dist-ssr/
# the second build the adaptive e2e project serves (port 4274)
dist-adaptive/
# PWA dev service worker
dev-dist/
build/
.vite/
# tsc -b incremental state
*.tsbuildinfo
.eslintcache

# ── Secrets and local config ────────────────────────────────────────────────
# FISH_API_KEY / FISH_VOICE_ID live in .env.local; never commit them.
.env
.env.*
!.env.example
*.local

# ── Personal data (never commit) ────────────────────────────────────────────
# The owner's event-log exports used as private golden-master fixtures
# (platform/04-QUALITY-AND-OPERATIONS.md §32.4), and any backup file saved by the app.
platform-fixtures/private/
owner-export*.json
system-backup-*.json
system-export-day-*.json
solo-leveling-backup-*.json
solo-leveling-export-day-*.json

# ── Test and tool artifacts ─────────────────────────────────────────────────
coverage/
.nyc_output/
playwright-report/
playwright/.cache/
test-results/
blob-report/
*.log
npm-debug.log*

# ── Scratch files at the repo root (ad-hoc screenshot scripts and the like) ─
/_*.mjs
/_*.cjs
/_*.js
/_*.ts
/tmp/
*.tmp
*.bak
*.orig
*.rej

# ── Editors ─────────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# ── OS ──────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Claude Code (local session state; not part of the project) ──────────────
.claude/

# ── Deliberately NOT ignored ────────────────────────────────────────────────
# public/voice/*.mp3 and manifest.json: `public/` is copied verbatim into the
# build, so ignoring the rendered voice pack would only keep it off the
# deployment, where the feature lives. A deployed build serves every clip to
# anyone who asks, so ignoring them in git would not make them private either.
# Regenerate with `npm run voice`; an absent clip falls back to the device voice.
#
# tests/e2e/visual-baseline.spec.ts-snapshots/*.png: the E3 pixel baselines
# are the regression contract. They are Windows/Chromium captures.

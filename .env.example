# Copy to .env.local (gitignored) and fill in as needed.

# Build-time only (scripts/generate-voice-pack.mjs); never shipped to the browser.
FISH_API_KEY=
FISH_VOICE_ID=

# Platform/preview builds ONLY: use a separate IndexedDB so a preview can
# never open or upgrade the production 'system-arc' database.
# Leave unset for production. See platform/05-ROADMAP.md loop 0.5.
# VITE_DB_NAME=system-arc-platform
